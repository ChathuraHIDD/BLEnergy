PORT=5050
# Local: postgres://USER@localhost:5432/blenergy
# Vercel + Neon: set automatically by the Neon integration (pooled URL)
DATABASE_URL=postgres://USER@localhost:5432/blenergy
# Optional direct (non-pooled) URL used for migrations – Neon integration sets this too
DATABASE_URL_UNPOOLED=
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Used only to create the admin account the first time the database is set up
ADMIN_USERNAME=BLEAdmin
ADMIN_PASSWORD=adminBL26
# Only needed if the web app is served from a different domain than the API
CORS_ORIGIN=
